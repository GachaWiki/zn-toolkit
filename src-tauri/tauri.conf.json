{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zn-toolkit",
  "version": "0.1.0",
  "identifier": "com.boring877.zntoolkit",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5181",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zone Nova Toolkit",
        "width": 1180,
        "height": 800,
        "minWidth": 880,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}